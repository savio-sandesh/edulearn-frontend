# ─────────────────────────────────────────────
# EduLearn Frontend — .gitattributes
# Ensures consistent line endings across Windows, macOS, Linux
# ─────────────────────────────────────────────

# Default: normalize to LF on checkout
* text=auto eol=lf

# Explicitly LF for source files
*.ts      text eol=lf
*.html    text eol=lf
*.scss    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.js      text eol=lf
*.md      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.txt     text eol=lf
*.xml     text eol=lf
*.svg     text eol=lf
*.editorconfig text eol=lf
*.gitignore    text eol=lf

# Binary files — never modify
*.ico     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.eot     binary
*.ttf     binary
*.otf     binary
*.pdf     binary
*.zip     binary
